# ShipAssistant — Environment Variable Overrides
# Copy this file to .env and edit as needed.
# All variables are optional — defaults come from configs/base.yaml + model.yaml + inference.yaml.
# Format: SHIP_<SECTION>__<KEY>=value

# ── Config file paths ─────────────────────────────────────────────────────────
# SHIP_BASE_CONFIG=configs/base.yaml
# SHIP_MODEL_CONFIG=configs/model.yaml
# SHIP_INFERENCE_CONFIG=configs/inference.yaml

# ── API server ────────────────────────────────────────────────────────────────
# SHIP_API__HOST=127.0.0.1
# SHIP_API__PORT=8000
# SHIP_API__MAX_FILE_SIZE_MB=5

# ── Model backend ─────────────────────────────────────────────────────────────
# SHIP_MODEL__TYPE=onnx          # 'onnx' (production) | 'torch' (debug)

# ── ONNX runtime ──────────────────────────────────────────────────────────────
# SHIP_ONNX__PRECISION=int8      # 'int8' | 'fp32' | 'fp16'
# SHIP_ONNX__TEMPERATURE=1.0     # >1.0 softens INT8-flattened distributions
# SHIP_ONNX__ADAPTIVE_THRESHOLD=true
# SHIP_ONNX__ADAPTIVE_WINDOW=20
# SHIP_ONNX__RECALIBRATE=false

# ── Recognition thresholds ────────────────────────────────────────────────────
# SHIP_RECOGNITION__DEFAULT_CONFIDENCE=0.8
# SHIP_RECOGNITION__FUZZY_THRESHOLD=68.0
# SHIP_RECOGNITION__DEBOUNCE_SECONDS=1.5

# ── Audio capture ─────────────────────────────────────────────────────────────
# SHIP_AUDIO__SAMPLE_RATE=16000
# SHIP_AUDIO__WINDOW_SECONDS=1.0
# SHIP_AUDIO__STRIDE_SECONDS=0.5
# SHIP_AUDIO__THRESHOLD_DB=-50.0
# SHIP_AUDIO__MAX_DURATION=3.0

# ── Real-time recognizer ──────────────────────────────────────────────────────
# SHIP_RECOGNIZER__RING_BUFFER_SECONDS=10.0
# SHIP_RECOGNIZER__BLOCKSIZE=2048
# SHIP_RECOGNIZER__MIC_RECONNECT_DELAY=2.0
# SHIP_RECOGNIZER__INFERENCE_POLL_INTERVAL=0.1

# ── Logging ───────────────────────────────────────────────────────────────────
# SHIP_LOGGING__LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR | CRITICAL
# SHIP_LOGGING__MAX_BYTES=10485760
# SHIP_LOGGING__BACKUP_COUNT=5

# ── Compute device ────────────────────────────────────────────────────────────
# SHIP_BASE__DEVICE=auto         # 'auto' | 'cpu' | 'cuda'
